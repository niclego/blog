---
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { path } from '../utils/url';
import type { Post } from '../utils/posts';

interface Props {
  post: Post;
  minutes: number;
  prev?: Post;
  next?: Post;
}

const { post, minutes, prev, next } = Astro.props;
const { title, description, pubDate, updatedDate, tags, draft } = post.data;
---

<BaseLayout {title} {description} type="article" publishedDate={pubDate}>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <FormattedDate date={pubDate} />
        <span aria-hidden="true"> · </span>
        {minutes} min read
        {draft && <span class="draft">Draft</span>}
      </p>
      {
        updatedDate && (
          <p class="meta updated">
            Updated <FormattedDate date={updatedDate} />
          </p>
        )
      }
    </header>

    <div class="prose">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {tags.map((tag) => (
            <li>
              <a href={path(`/tags/${tag}`)}>#{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
  </article>

  {
    (prev || next) && (
      <nav class="pager" aria-label="More posts">
        <div>
          {next && (
            <a href={path(`/posts/${next.id}`)}>
              <span class="dir">← Newer</span>
              <span class="t">{next.data.title}</span>
            </a>
          )}
        </div>
        <div class="right">
          {prev && (
            <a href={path(`/posts/${prev.id}`)}>
              <span class="dir">Older →</span>
              <span class="t">{prev.data.title}</span>
            </a>
          )}
        </div>
      </nav>
    )
  }
</BaseLayout>

<style>
  header {
    margin-bottom: 2.25rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  header h1 {
    margin-bottom: 0.5rem;
  }

  header .meta {
    margin: 0;
  }

  .updated {
    margin-top: 0.25rem;
    color: var(--text-faint);
  }

  .draft {
    margin-left: 0.6rem;
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 0.1rem 0.5rem;
  }

  /* An illuminated opening letter, the way a scribe would have marked the
     start of a text. Scoped to `:first-child` rather than `:first-of-type` so
     it only fires when a post genuinely opens on a paragraph — a post
     starting with a heading or a list gets no drop cap instead of one
     stranded halfway down the page. */
  .prose > :global(p:first-child::first-letter) {
    float: left;
    font-family: var(--font-serif);
    font-size: 3.3em;
    font-weight: 600;
    line-height: 0.82;
    padding-right: 0.08em;
    padding-top: 0.06em;
    color: var(--accent);
  }

  /* Headings inside the body get a lighter top margin than the global rule. */
  .prose :global(h2) {
    margin-top: 2.25rem;
  }

  .prose :global(h3) {
    margin-top: 1.75rem;
  }

  /* Anchor links added by rehype-autolink-headings. */
  .prose :global(.heading-anchor) {
    margin-left: 0.4rem;
    color: var(--text-faint);
    text-decoration: none;
    opacity: 0;
    transition: opacity 0.12s ease;
  }

  .prose :global(h2:hover .heading-anchor),
  .prose :global(h3:hover .heading-anchor),
  .prose :global(h4:hover .heading-anchor),
  .prose :global(.heading-anchor:focus-visible) {
    opacity: 1;
  }

  .tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    padding: 0;
    margin: 2.5rem 0 0;
  }

  .tags li {
    margin: 0;
  }

  /* Tags sit a step back from links, on the softer tint of the same blue. */
  .tags a {
    font-size: 0.82rem;
    color: var(--accent-soft);
    text-decoration: none;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
  }

  .tags a:hover {
    color: var(--accent-soft-hover);
    border-color: var(--accent-soft);
  }

  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .pager .right {
    text-align: right;
  }

  .pager a {
    display: block;
    text-decoration: none;
  }

  .pager .dir {
    display: block;
    font-size: 0.78rem;
    color: var(--text-faint);
    margin-bottom: 0.15rem;
  }

  .pager .t {
    color: var(--text);
    font-size: 0.94rem;
    line-height: 1.4;
  }

  .pager a:hover .t {
    color: var(--accent);
  }

  @media (max-width: 34rem) {
    .pager {
      grid-template-columns: 1fr;
    }
    .pager .right {
      text-align: left;
    }
  }
</style>
