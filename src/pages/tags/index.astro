---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getTags } from '../../utils/posts';
import { path } from '../../utils/url';

const tags = await getTags();
---

<BaseLayout title="Tags" description="Browse posts by topic.">
  <h1>Tags</h1>

  {tags.length === 0 && <p class="muted">No tags yet.</p>}

  <ul>
    {
      tags.map(({ tag, count }) => (
        <li>
          <a href={path(`/tags/${tag}`)}>
            #{tag}
            <span class="meta">{count}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  li {
    margin: 0;
    max-width: none;
  }

  li + li {
    margin-top: 0;
  }

  a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--accent-soft);
    text-decoration: none;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.25rem 0.8rem;
  }

  a:hover {
    color: var(--accent-soft-hover);
    border-color: var(--accent-soft);
  }

  .meta {
    font-size: 0.78rem;
    color: var(--text-faint);
  }
</style>
