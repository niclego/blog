---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, getTags } from '../../utils/posts';
import { path } from '../../utils/url';
import type { InferGetStaticPropsType } from 'astro';

export async function getStaticPaths() {
  const [posts, tags] = await Promise.all([getPosts(), getTags()]);

  return tags.map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag, posts } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Posts tagged ${tag}.`}>
  <h1>#{tag}</h1>
  <p class="meta count">
    {posts.length}
    {posts.length === 1 ? 'post' : 'posts'} · <a href={path('/tags')}>all tags</a>
  </p>

  {posts.map((post) => <PostCard post={post} />)}
</BaseLayout>

<style>
  .count {
    margin-bottom: 2rem;
  }
</style>
